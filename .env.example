# CreatorOS local configuration example.
# Copy to .env only if you know you need it. Never commit the real file.
# Most users should use scripts/set_env.ps1 instead.

# Where the database, media, models, logs and secrets live.
# Default: %USERPROFILE%\CreatorOS
CREATOROS_ROOT=C:\Users\you\CreatorOS

# Local Ollama endpoint. CreatorOS never sends prompts to a cloud model.
CREATOROS_OLLAMA_URL=http://127.0.0.1:11434

# Optional explicit FFmpeg bin directory. Default: <CREATOROS_ROOT>\tools\ffmpeg\bin
# CREATOROS_FFMPEG_DIR=C:\Users\you\CreatorOS\tools\ffmpeg\bin

# Bind address for the local API. Keep it on loopback.
CREATOROS_HOST=127.0.0.1

# 0 lets the operating system choose a free port; Electron reports it to the renderer.
CREATOROS_PORT=0

# INFO, WARNING, ERROR. Debug logs may contain local paths; review before sharing.
CREATOROS_LOG_LEVEL=INFO

# Test and automation switches. Leave these unset for normal use.
# CREATOROS_DISABLE_AI=1
# CREATOROS_DISABLE_WORKERS=1
# CREATOROS_RUN_LIVE_AI=1
# CREATOROS_DEBUG_PORT=9222

# Never put provider client secrets or account tokens in this file.
# Use the in-app developer app settings, which write to the encrypted vault.
